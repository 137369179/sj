generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  vendor
  organizer
  admin
}

enum MarketStatus {
  draft
  published
  recruiting
  reviewing
  confirmed
  ongoing
  completed
}

enum ApplicationStatus {
  submitted
  under_review
  approved
  rejected
  stall_assigned
  paid
}

model User {
  id                    String         @id @default(cuid())
  phone                 String         @unique
  role                  UserRole
  name                  String
  isVerified            Boolean        @default(false)
  createdAt             DateTime       @default(now())
  organizedMarkets      Market[]       @relation("OrganizerMarkets")
  applications          Application[]  @relation("VendorApplications")
  notifications         Notification[]
  orders                Order[]
}

model Market {
  id                    String         @id @default(cuid())
  organizerId           String
  title                 String
  city                  String
  coverUrl              String?
  description           String?        @db.Text
  startsAt              DateTime
  endsAt                DateTime
  status                MarketStatus   @default(draft)
  isPlatformApproved    Boolean        @default(false)
  organizer             User           @relation("OrganizerMarkets", fields: [organizerId], references: [id])
  applications          Application[]
  stalls                Stall[]
}

model Application {
  id                    String            @id @default(cuid())
  marketId              String
  vendorId              String
  status                ApplicationStatus @default(submitted)
  note                  String?
  applicationNote       String?
  reviewNote            String?
  boothPreference       String?
  attachmentsJson       Json?
  reviewedAt            DateTime?
  reviewedByUserId      String?
  createdAt             DateTime          @default(now())
  market                Market            @relation(fields: [marketId], references: [id])
  vendor                User              @relation("VendorApplications", fields: [vendorId], references: [id])
  assignedStall         Stall?            @relation("AssignedStall")
  reviews               ApplicationReview[]
  order                 Order?

  @@unique([marketId, vendorId])
}

model Order {
  id             String      @id @default(cuid())
  applicationId  String      @unique
  vendorId       String
  amount         Float
  status         OrderStatus @default(pending)
  paymentMethod  String?
  paidAt         DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  application    Application @relation(fields: [applicationId], references: [id])
  vendor         User        @relation(fields: [vendorId], references: [id])
}

enum OrderStatus {
  pending
  paid
  refunded
  cancelled
}

model ApplicationReview {
  id                    String   @id @default(cuid())
  applicationId         String
  organizerId           String
  decision              String
  reviewNote            String?
  createdAt             DateTime @default(now())
  application           Application @relation(fields: [applicationId], references: [id])

  @@index([applicationId, createdAt])
}

model Stall {
  id                    String       @id @default(cuid())
  marketId              String
  code                  String
  name                  String
  price                 Float        @default(0)
  isActive              Boolean      @default(true)
  assignedApplicationId String?      @unique
  market                Market       @relation(fields: [marketId], references: [id])
  assignedApplication   Application? @relation("AssignedStall", fields: [assignedApplicationId], references: [id])

  @@unique([marketId, code])
}

model Notification {
  id                    String   @id @default(cuid())
  userId                String
  title                 String
  content               String
  readAt                DateTime?
  createdAt             DateTime @default(now())
  user                  User     @relation(fields: [userId], references: [id])
}
